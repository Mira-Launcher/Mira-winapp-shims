<Project Sdk="Microsoft.NET.Sdk">
  <!-- Built for .NET Framework 4, as Wine's .NET (wine-mono) loads it. Microsoft's public key, delay-signed (only
       its public half is here), gives it the identity programs reference; wine-mono doesn't check signatures. -->
  <PropertyGroup>
    <TargetFramework>net40</TargetFramework>
    <AssemblyName>System.Management.Automation</AssemblyName>
    <RootNamespace>System.Management.Automation</RootNamespace>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <FileVersion>3.0.0.0</FileVersion>
    <SignAssembly>true</SignAssembly>
    <DelaySign>true</DelaySign>
    <AssemblyOriginatorKeyFile>msft.pub</AssemblyOriginatorKeyFile>
    <LangVersion>7.3</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
